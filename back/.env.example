# Browser origin(s), comma-separated when using multiple frontends.
# Set to the exact deployed frontend origin(s) in production; do not include paths.
DOMAIN_NAME=http://localhost:3000

# Production Vercel frontend/API are cross-site; set this to "none" there.
# SameSite=None also requires HTTPS.
# Use a same-site frontend/API deployment if browser third-party-cookie restrictions apply.
AUTH_COOKIE_SAME_SITE=lax
